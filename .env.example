# Gemini API keys (comma-separated pool; rotated per session and on quota errors)
GEMINI_KEYS=key1,key2
# Optional: Live model (default: gemini-3.1-flash-live-preview)
GEMINI_LIVE_MODEL=gemini-3.1-flash-live-preview

# Home Assistant (optional – without it the smart home tools have no context)
HA_URL=http://homeassistant.local:8123
HA_TOKEN=your_long_lived_access_token

# Short-term memory: how many recent sessions go into the prompt, and how old (minutes) the last turn may be
#JARVIS_CONTEXT_SESSIONS=3
#JARVIS_CONTEXT_MAX_AGE_MIN=30

# Semantic archive search uses Gemini embeddings (same API key). Set to 0 for keyword-only search.
#JARVIS_EMBEDDINGS=1
#JARVIS_EMBED_MODEL=gemini-embedding-001

# Hardware button (cancels a running session). Default GPIO 23 (AIY Voice Bonnet V2); "none" disables it.
#JARVIS_BUTTON_PIN=23

# Session end: seconds of silence after Jarvis spoke. User speech that Gemini doesn't answer (music, TV)
# extends it by at most JARVIS_SPEECH_GRACE seconds, less the longer Jarvis has been listening.
#JARVIS_IDLE_TIMEOUT=15
#JARVIS_SPEECH_GRACE=6
# While the user speaks (server-side voice detection) the timer pauses, for at most this many seconds.
#JARVIS_MAX_SPEECH=20
