# Gemini API keys (comma-separated pool; rotated per session and on quota errors)
GEMINI_KEYS=key1,key2
# Optional: Live model (default: gemini-3.1-flash-live-preview)
GEMINI_LIVE_MODEL=gemini-3.1-flash-live-preview

# Home Assistant (optional – without it the smart home tools have no context)
HA_URL=http://homeassistant.local:8123
HA_TOKEN=your_long_lived_access_token

# OpenClaw (optional): Jarvis asks this agent whenever it doesn't know something (tool ask_openclaw).
# Without URL and token the tool is off. The Gateway needs gateway.http.endpoints.chatCompletions.enabled = true.
# The token is the Gateway token and grants full operator access, so only use the endpoint on your LAN.
#OPENCLAW_URL=http://openclaw-host:18789
#OPENCLAW_TOKEN=your_gateway_token
# Name Jarvis uses for the agent, agent id, optional model override (provider/model; empty = the agent's own)
#OPENCLAW_NAME=OpenClaw
#OPENCLAW_AGENT=default
#OPENCLAW_MODEL=
# Seconds to wait for an answer; after this many idle minutes the next question starts a fresh OpenClaw session
#OPENCLAW_TIMEOUT=90
#OPENCLAW_SESSION_IDLE_MIN=30

# Short-term memory: how many recent sessions go into the prompt, and how old (minutes) the last turn may be
#JARVIS_CONTEXT_SESSIONS=3
#JARVIS_CONTEXT_MAX_AGE_MIN=30

# Semantic archive search uses Gemini embeddings (same API key). Set to 0 for keyword-only search.
#JARVIS_EMBEDDINGS=1
#JARVIS_EMBED_MODEL=gemini-embedding-001

# Microphone: high-pass cutoff in Hz against mains hum and rumble (0 = off)
#JARVIS_MIC_HIGHPASS=150
# Wake word confidence threshold (0-1). Scores from 60 % of it upwards are logged as "near miss".
#JARVIS_WAKE_THRESHOLD=0.5

# Hardware button (cancels a running session, stops a ringing alarm). Default GPIO 23 (AIY Voice Bonnet V2); "none" disables it.
#JARVIS_BUTTON_PIN=23

# Timers and alarms: a ringing alarm stops by itself after this many seconds (or on wake word / button)
#JARVIS_ALARM_TIMEOUT=120

# Session end: seconds of silence after Jarvis spoke. User speech that Gemini doesn't answer (music, TV)
# extends it by at most JARVIS_SPEECH_GRACE seconds, less the longer Jarvis has been listening.
#JARVIS_IDLE_TIMEOUT=15
#JARVIS_SPEECH_GRACE=6
# While the user speaks (server-side voice detection) the timer pauses, for at most this many seconds.
#JARVIS_MAX_SPEECH=20
