# Copy to /etc/systemd/system/jarvis.service and adjust User and paths to your install.
[Unit]
Description=Jarvis V3 AI Voice Assistant
After=network.target sound.target

[Service]
Type=simple
User=pi
WorkingDirectory=/home/pi/jarvis_v3
Environment=PYTHONUNBUFFERED=1
ExecStartPre=/bin/sleep 2
ExecStart=/home/pi/jarvis_v3/venv/bin/python /home/pi/jarvis_v3/main.py
TimeoutStopSec=5
KillMode=control-group
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
